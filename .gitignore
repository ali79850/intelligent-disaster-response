# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data (never commit datasets)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Models (never commit large checkpoints)
models/*
!models/.gitkeep
!models/README.md

# Node / frontend
app/frontend/node_modules/
app/frontend/dist/

# Environment / secrets
.env
*.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Reports (generated, not source)
reports/figures/*
!reports/figures/.gitkeep

# Logs
*.log
logs/